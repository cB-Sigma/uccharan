NAS = ̃
VO = a e i o u æ
RT = m n l ʃ s h ɾ j
K = χ w k ɡ ŋ t ʃ ʰ ɟ n ʈ ɖ d p f b m ɾ r l h j s ː . ʒ

[pre]
ক্ষ -> ক্শ
স -> S / _ ্থ | _ ্ত
# Bengali র is not an Assamese letter: the reference leaves it silent.
র -> 0
জ্ঞ -> গ্গ
স্ব -> শ / # _
জ্ব -> জ
অ্যা -> Ǽ
# ya-phala (্য). Medially before a vowel sign it is read dʒ; before a
# consonant, and as ্যা inside a word, it is æ; at the end of a word it
# lengthens the consonant before it (ː), or doubles n, l, m, ʈ, ʃ, s and r.
্যা -> Æ / _ . | # {C} _
্য -> Æ / _ {C}
্য -> ্ন / ন _ # | ন _ {M} # | ন _ া #
্য -> ্ণ / ণ _ # | ণ _ {M} # | ণ _ া #
্য -> ্ল / ল _ # | ল _ {M} # | ল _ া #
্য -> ্ম / ম _ # | ম _ {M} # | ম _ া #
্য -> ্ট / ট _ # | ট _ {M} # | ট _ া #
্য -> ্ড / ড _ # | ড _ {M} # | ড _ া #
্য -> ্শ / শ _ # | শ _ {M} # | শ _ া #
্য -> ্ষ / ষ _ # | ষ _ {M} # | ষ _ া #
্য -> ্র / র _ # | র _ {M} # | র _ া #
্য -> ্Y / _ # | _ {M} # | _ া #
# Word-final ত and হ keep a vowel, written o.
ত -> তো / _ #
হ -> হো / _ #

[pre.compat]
# A bare ৱ is read wa followed by the vowel ɔ.
ৱ -> ৱাঅ / _ {C} | _ #
ঁ -> 0 / ও _
# After ৱ the reference reads a vowel sign as a separate vowel (ৱা = wɔ a).
া -> আ / ৱ _
ি -> ই / ৱ _
ী -> ঈ / ৱ _
ে -> এ / ৱ _
# No nasal mark on ্যাঁ.
ঁ -> 0 / Æ _
# The reference loses the vowel sign after a nukta written as a separate
# code point (base letter + U+09BC), which is how normalised text spells
# these letters: the letter is then read without a vowel, and decomposed
# য় loses itself too.
য় -> 0 / _ {M}
{M} -> ্ / ড় _ | ঢ় _
{M} -> 0 / য় _

[post]
# The inherent vowel after χ is ə.
ɔ -> ə / χ {S}* _ {!NAS} | χ {S}* _ #
# r before sonorants and fricatives, the tap elsewhere.
ɾ -> r / _ {RT}
# The inherent vowel of the first syllable is raised before i or u, and after
# an initial r when a full vowel follows.
ɔ -> o / # {K}* {S}* _ {K}* {S}* {HI} | # {K}* ɾ {S}* _ {K} {K}* {S}* {VO} | # {K}* ɾ {S}* _ {K} {K}* {S}* ɔ {K}
# i and u after e are glides before a consonant (u also at the end).
i -> j / {K} e _ {K}
u -> w / e _ {K} | e _ #

