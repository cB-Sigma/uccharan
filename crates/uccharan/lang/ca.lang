[clause]
# Final s, t, p, k are voiced before a voiced consonant, s also before a
# vowel; a final n takes the place of the next consonant; b d ɡ at the
# start of a word are spirants after a vowel or a continuant; i and u at
# the start of a word are glides after a vowel.
s -> ʒ / _ ‿ ʒ
z -> ʒ / _ ‿ ʒ
s -> z / _ ‿ {VC} | _ ‿ ⁑ | _ ‿ ⁂
ʃ -> ʒ / _ ‿ {VC} | _ ‿ ⁑ | _ ‿ ⁂
m -> ɱ / _ ‿ f
t -> d / _ ‿ {VC}
# p stays before l.
p -> b / _ ‿ {VL}
k -> ɡ / _ ‿ {VC}
n -> m / _ ‿ p | _ ‿ b | _ ‿ m | _ ‿ β
n -> ŋ / _ ‿ k | _ ‿ ɡ
n -> ɱ / _ ‿ f
n -> ɲ / _ ‿ ʎ
l -> ʎ / _ ‿ ʎ
d -> ð / {SP} ‿ _ | {SP} ‿ ⁑ _
b -> β / {SP} ‿ _ | l ‿ _ | ʎ ‿ _
ɡ -> ɣ / {SP} ‿ _ | l ‿ _ | ʎ ‿ _
# A word-initial i is a glide after a vowel other than an unstressed i.
i -> j / {PI} ‿ ⁑ _ {!B} | ˈ i ‿ ⁑ _ {!B}
# The conjunction i, the pronoun hi and an unstressed final i are a glide
# before a word written with a vowel letter (or h) first, but not before u
# (the conjunction after a vowel letter is read j by [context.compat]).
i -> j / {CN} _ ‿ ⁑ | ‿ ⁑ _ ‿ ⁑ | # ⁑ _ ‿ ⁑
j -> i / ‿ ⁑ _ ‿ ⁂ | # ⁑ _ ‿ ⁂
# u at the start of a word after a vowel that stays a vowel, and an
# unstressed final u (ho, lo) before a vowel, are a glide; the conjunction o between vowels is w.
u -> w / {PY} ‿ ⁑ _ | {PX} ‿ ⁂ ⁑ _ | {CN} ‿ ⁑ ˈ ɔ ‿ ⁂ ⁑ _ | # ⁑ ˈ ɔ ‿ ⁂ ⁑ _ | {CN} _ ‿ ⁑ | {CN} _ ‿ ⁂ | ‿ ⁑ _ ‿ ⁑ | ‿ ⁑ _ ‿ ⁂
ˈɔ -> w / {PV} ‿ ⁑ _ ‿ ⁑ | {PV} ‿ ⁑ _ ‿ ⁂
# A final r is a tap before a vowel; after a stressed vowel it is a trill
# before a consonant and at the end (not in "per").
r -> ɾ / _ ‿ ⁑ | _ ‿ ⁂
ɾ -> r / ˈ {PV} _ ‿ {CN} | ˈ {PV} _ #

[context.compat]
# The conjunction i after a word written with a vowel letter last.
i *a|*e|*i|*o|*u|*à|*è|*é|*í|*ò|*ó|*ú|*ï|*ü j

