# Czech. espeak-ng voice "cs". Letter rules for words outside the
# word table, the number words and the letter names.

[meta]
spell-stress = first
tag = cs
vowels = a e i o u ɪ ʊ
stress = initial
secondary = auto
stress-options = final-no-secondary
fuse = na do pro o bez ze po za před od při nad pod
spell-vowels = aeiouyáéíóúůýě

[classes]
V = a e i o u y á é í ó ú ů ý ě
VL = p t k f s ʃ x c
VO = b d ɡ z ʒ ɦ ɟ

[pre]
ch -> x
á -> aː
é -> ɛː
í -> iː
ó -> oː
ú -> uː
ů -> uː
ý -> iː
y -> i
dě -> ɟe
tě -> ce
ně -> ɲe
mě -> mɲe
ě -> je
di -> ɟi
ti -> ci
ni -> ɲi
ď -> ɟ
ť -> c
ň -> ɲ
š -> ʃ
č -> tʃ
ž -> ʒ
ř -> r̝
c -> ts
h -> ɦ
w -> v
g -> ɡ
q -> kv
x -> ks

[post]


[clause]
# A final obstruent takes the voicing of an obstruent that begins the next word.
p -> b / _ ‿ {VO}
b -> p / _ ‿ {VL}
t -> d / _ ‿ {VO}
d -> t / _ ‿ {VL}
k -> ɡ / _ ‿ {VO}
ɡ -> k / _ ‿ {VL}
ʃ -> ʒ / _ ‿ {VO}
ʒ -> ʃ / _ ‿ {VL}
x -> ɣ / _ ‿ {VO}
ɣ -> x / _ ‿ {VL}

