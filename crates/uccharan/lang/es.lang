# Spanish (Spain). espeak-ng voice "es". Written for uccharan:
# letter rules, the Spanish stress rule, secondary stress on
# alternate syllables before the primary, spirantisation of b d g and nasal
# place assimilation inside the clause.

[meta]
letter-names = yes
tag = es
vowels = a e ɛ i o u ı
stress = spanish
secondary = alternate
# -mente adverbs keep the stress of the adjective as well.
suffix = mente mˈᴇnte
spell-close-e = yes

[classes]
IV = a e i o u ɛ ɔ
IVD = b β d ð ɡ ɣ m n ɲ l ʎ ʝ r ɾ
IST = ˈ ˌ
V = a e i o u á é í ó ú ü y ì
VV = a e i o u á é í ó ú ü ì
ACC = á é í ó ú
AEO = a e o á é ó
NV = b c d f g h j k l m n ñ p q r s t v w x z
FV = e i é í
# Phoneme classes.
P = a e ɛ i o u ı ɪ ʊ j w ɾ r l s θ f x ʝ ʎ β ð ɣ z ʃ
VEL = ɡ x
SN = p t k b d ɡ m n
SNJ = p t k b d ɡ m n ‿
LAB = b p β
J = ‿
NN = n m
PV = a e ɛ i o u ˈ ˌ
PC = p t k b d ɡ f θ s x tʃ ʝ ʎ m n ɲ l ɾ r ʃ β ð ɣ

[pre]
# Written accents mark the stressed vowel.
á -> ˈa
é -> ˈe
í -> ˈi
ó -> ˈo
ú -> ˈu
# "ì" only in number words: an i of its own syllable.
ì -> ı
# Falling diphthongs.
ai -> aɪ / _ {NV} | _ #
ei -> eɪ / _ {NV} | _ #
oi -> oɪ / _ {NV} | _ #
ay -> aɪ / _ {NV} | _ #
ey -> eɪ / _ {NV} | _ #
oy -> oɪ / _ {NV} | _ #
uy -> uj / _ #
au -> aʊ / _ {NV} | _ #
eu -> eʊ / _ {NV} | _ #
# Rising diphthongs: i and u before another vowel are glides.
# After r, l and a consonant + r or l, i and u before a vowel are said as
# vowels; i does not make a syllable of its own for stress (ⅰ) unless an
# accented vowel follows.
i -> ı / {NV} r _ {ACC} | {NV} l _ {ACC}
i -> ⅰ / # r _ {VV} | # l _ {VV} | {NV} r _ {VV} | {NV} l _ {VV}
u -> u / l _ {VV} | r _ {VV}
ou -> ow / _ {NV} | _ #
i -> j / _ {VV}
u -> w / _ {VV}
ü -> u
# Consonants.
qu -> k / _ {FV}
gu -> ɡ / _ {FV}
gü -> ɡu
ch -> tʃ
ll -> ʎ
rr -> r
cc -> kθ / _ {FV}
c -> θ / _ {FV}
c -> k
z -> θ
g -> x / _ {FV}
g -> ɡ
j -> x
h -> 0
ñ -> ɲ
v -> b
x -> ks
y -> i / # _ #
y -> ʝ / _ {V}
y -> i
r -> r / # _ | n _ | l _ | s _
r -> ɾ
ps -> s / # _

[post]
ı -> i
ⅰ -> i
# p before t is long.
p -> pː / _ t
# Nasal place inside the word.
n -> m / _ b | _ p | _ f ɾ
n -> ŋ / _ {VEL}

[clause]
# b d g are spirants after a vowel or a continuant, also across words.
# A word-final d stays a stop before a consonant; g before a nasal stays a stop.
# A word-final d stays a stop before a consonant; b d g before a stop or
# nasal stay stops.
b -> β / {P} _ {!SNJ} | {P} ‿ _ | d ‿ _
d -> ð / {P} _ {!SNJ} | {P} ‿ _ | {P} _ ‿ {PV} | d ‿ _
ɡ -> ɣ / {P} _ {!SNJ} | {P} ‿ _ | d ‿ _
# Stressed e before n and a consonant is open.
ˈe -> ˈɛ / _ n {PC} | _ n tʃ | _ ŋ {PC}
# The -mente suffix keeps a close e.
ᴇ -> e
# A final n takes the place of the next word's first consonant.
n -> m / _ ‿ b | _ ‿ p | _ ‿ f ɾ
n -> ŋ / _ ‿ ɡ

[post.improved]
# The open e and the diphthong notation are conventions of the espeak-ng
# voice; d after l and n is a stop (Martínez-Celdrán et al. 2003).
ɛ -> e
aɪ -> ai
eɪ -> ei
oɪ -> oi
aʊ -> au
eʊ -> eu
ð -> d / l _ | n _
# Final d after a vowel is the approximant ð; n before f is ɱ; s before a
# voiced consonant is z; an unstressed u before a vowel is the glide w
# (Martínez-Celdrán et al. 2003; Navarro Tomás).
d -> ð / {IV} _ #
n -> ɱ / _ f
s -> z / _ {IVD}
u -> w / {!IST} _ {IV} | {!IST} _ ˈ {IV} | # _ {IV} | # _ ˈ {IV}

