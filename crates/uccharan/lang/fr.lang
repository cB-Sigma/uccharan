# French. espeak-ng voice "fr". Written for uccharan: silent
# final letters, nasal vowels, vowel digraphs, soft c and g, stress on the
# last full syllable, liaison consonants before a vowel inside a clause.

[meta]
caps-entries = yes
caps-words = a es et la les est
tag = fr
vowels = a ɑ e ɛ i o ɔ u y ø œ ə
unstressable = ə
stress = final
secondary = none
elision = yes
spell-vowels = aeiouyàâéèêëîïôöùûüœæ
# "ils ont", "elles sont": no stress on the verb after a clitic pronoun.
clitic-verbs = ont sont
clitic-subjects = ils elles il se ne qui qu'ils qu'elles me s'en s'ils les nous lui leur vous en n'en y n'y le la lorsqu'ils lorsqu'elles puisqu'ils puisqu'elles

