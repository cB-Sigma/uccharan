ᵗ -> 0
ⁿ -> 0
ʳ -> 0
ᵖ -> 0
ˢ -> 0
ᵀ -> 0
ᶠ -> f

[post.improved]
# u before i is the glide ɥ (Fougeron & Smith 1993).
