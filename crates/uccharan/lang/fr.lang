[clause]
# A latent final consonant is said before a vowel of the next word.
ᶻ -> z / _ ‿ {VW}
ᵗ -> t / _ ‿ {VW}
ⁿ -> n / _ ‿ {VW}
ʳ -> ʁ / _ ‿ {VW}
ᵖ -> p / _ ‿ {VW}
# six, dix: s at the end of a clause and before a word that blocks liaison,
# z before a vowel, nothing before a consonant; huit: t but before a consonant;
# neuf: v before ans and heures.
ˢ -> s / _ ‿ ⁞ | _ #
ˢ -> z / _ ‿ {VW}
ᵀ -> t / _ ‿ {VW} | _ ‿ ⁞ | _ #
ᶠ -> v / _ ‿ ˈ ɑ̃ ᶻ | _ ‿ ˈ ɑ̃ ‿ | _ ‿ ˈ ɑ̃ # | _ ‿ ˈ œ ʁ ᶻ | _ ‿ ˈ œ ʁ ‿ | _ ‿ ˈ œ ʁ #
