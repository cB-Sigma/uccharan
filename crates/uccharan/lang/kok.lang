# Konkani in Devanagari. espeak-ng voice "kok". Written for uccharan from
# specs/kok.md. The reference voice reads every vowel sign by its name
# ("-kār"), the virama, visarga, candrabindu and most anusvaras by their
# names; compatible mode reproduces that, improved mode reads Konkani as an
# Indic language.

[meta]
tag = kok
block = 0900
stress = penult
explicit-stress = yes
keep-after-schwa-of = s
final-keep-after = tʰ w j s
final-keep-after-vowel = hˈʌləntˈə
keep-schwa-after = h wː
final-release = ɾ n l ɭ w ŋ ɲ ɳ
anusvara-after-independent = nasal
deletion = medial
inherent = ə ʌ
anusvara = split
visarga = h
# A word with र + nukta is spelled out with Hindi letter names.
spell-if-sequence = ऱ

