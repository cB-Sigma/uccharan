[classes]
VIR = ്
DT = ക ത ട പ
V = a e i o u ɐ ə ɨ ː
VV = a e i o u ɐ ə ɨ
S = ˈ ˌ
ASP = ʰ
N = m n ŋ ɲ ɳ
SON = j ɾ l ɭ
C = k ɡ ŋ c ɟ ɲ ʈ ɖ ɳ t d n p b m j ɾ r l ɭ v ɕ ʂ s h ʰ .

[pre]
റ്റ -> ട്ട
ന്റ -> ന്ദ
# A word-final virama is read ɨ, except after a single stop.
് -> Ɨ / ത്ത _ # | ട്ട _ # | ക്ക _ # | പ്പ _ #
് -> ് / {DT} _ #
് -> Ɨ / _ #

[post]
# The inherent vowel is ɐ in the first syllable and at the end of a word.
ə -> ɐ / # {C}* _ | _ # | ˌ _
# Single stops are voiced before a vowel after a vowel, nasal, sonorant or s;
# t also after n and at the end of a word after a vowel.
k -> ɡ / {V} _ {S}* {VV} | {N} _ {S}* {VV} | {SON} _ {S}* {VV} | s _ {S}* {VV} | {C} {VV} _ #
t -> d / {V} _ {S}* {VV} | {N} _ {S}* {VV} | {SON} _ {S}* {VV} | s _ {S}* {VV} | n _ | {C} {VV} _ #
ʈ -> ɖ / {V} _ {S}* {VV} | {N} _ {S}* {VV} | {SON} _ {S}* {VV} | s _ {S}* {VV}
p -> b / {V} _ {S}* {VV} | {N} _ {S}* {VV} | {SON} _ {S}* {VV} | s _ {S}* {VV}

[post.improved]
r. -> ɻ

