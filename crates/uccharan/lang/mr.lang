# Markers written by the [pre] rules (never in real text).
J ɟ consonant
D d consonant
Ī i sign

[classes]
C = क ख ग घ ङ च छ ज झ ञ ट ठ ड ढ ण त थ द ध न प फ ब भ म य र ल ळ व श ष स ह
S = ˈ ˌ
NV = a i u o ɔ ɛ ə ʌ

[pre]
ज्ञ -> D्ण्य
क्ष -> क्श
# ज is z, but palatal before y and i-vowels, where the reference also
# repeats the vowel.
जी -> JĪी
ट्य -> ट्ट्य
जि -> Jिि

[pre.compat]
# ज before i-vowels is palatal in the reference, which also repeats the vowel.
जी -> JĪी
जि -> Jिि
# ज़ is silent in the reference (both spellings).
ज़ -> 0
ज़ -> 0

[post]
# Long ii is written long only under stress and not word-finally.
iː -> i / _ # | {!S} _ | # _
ɪ̃ -> ĩ
ʊ̃ -> ũ
# Nasal vowels other than e have no length mark.
ː -> 0 / {NV} ̃ _
# An unaspirated stop before its aspirated twin is written aspirated.
c -> cʰ / _ cʰ
ʈ -> ʈʰ / _ ʈʰ
ɖ -> ɖʰ / _ ɖʰ

[post.improved]
r.h -> ɽʰ
r. -> ɽ

