[numbers]
# The words the reference voice says for currency signs, where the sign
# stands (improved mode: after the amount).
currency $ ¤dollar#
# Improved mode and normalise-only mode: the currency word agrees with
# the amount (`currency-plural`, `currency-singular`, `currency-many` by
# the `plural` rule); `currency-count` gives the words for an amount
# before a currency word ("1 €", `*`: every currency).
currency-count * 1 en
# Improved mode and normalise-only mode: clock times. `time` lists the
# written forms read as times (h: "10h30" "10 h 30" "10h"; colon: "10:30";
# dot: "10.30"; dot-context: "10.30" after a `time-context` word or before
# a `time-after` word).
time colon dot

