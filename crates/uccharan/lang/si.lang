S = ˈ ˌ

[pre]
# Anusvara: velar before velars and h, palatal, retroflex, else m.
ං -> Ŋ / _ {VEL}
ං -> Ɲ / _ {PAL}
ං -> Ɽ / _ {RET}
ං -> Ɱ
# A word-final ව after a vowel has no vowel.
ව -> Ŵ / . _ #

[pre.improved]
# ශ is ʃ for most speakers.
ශ -> ෂ

[post]
# ර without a vowel is the trill.
ɹ -> r / _ {CO} | _ #

[post.improved]

