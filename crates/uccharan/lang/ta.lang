மத்திய -> மD்Dிய / # _
சாத்திய -> சாD்Dிய / # _
புத்தர் -> BுD்Dர் / # _
# Second element of a compound or the auxiliary படு "experience": p stays voiceless.
ப -> P / {TV} _ ட | ் _ ட
# முன் "before" + stop: no voicing across the boundary.
முன்பதி -> முன்Pதி / # _
# Loans: an initial consonant + i + r is a cluster (பிர- = pr-).
ி -> ் / # {KP} _ ர

[post]
# The palatal: tʃː doubled, dʒ after ɲ, s elsewhere.
cc -> tʃː
ʈc -> ɖtʃ
c -> tʃ / _ #
c -> dʒ / ɲ _
c -> s
# Stops are voiced after a vowel, a nasal or a sonorant (not when doubled,
# not at the start of a word).
k -> ɡ / {V} _ {S}* {VV} | {N} _ | {SON} _ {S}* {VV}
t -> d / {V} _ {S}* {VV} | {N} _ | {SON} _ {S}* {VV}
ʈ -> ɖ / {V} _ {S}* {VV} | {N} _ | {SON} _ {S}* {VV}
p -> b / {V} _ {S}* {VV} | {N} _ | {SON} _ {S}* {VV}
# Unstressed u is the "half-u" ʉ.
uː -> ʉ / {!P} _
u -> ʉ / {!P} _ {!LONG} | {!P} _ #
# ர is a trill before a consonant and at the end of a word.
ɹ -> r / _ {C} | _ #
P -> p

