# Urdu. espeak-ng voice "ur". Written for uccharan from specs/ur.md. The
# script is decoded like an Indic script: every consonant letter carries a
# short vowel unless a vowel letter, a vowel mark or jazm follows, and the
# Hindi-type deletion and stress rules apply. In compatible mode common words
# come from the word table `data/ur.ucd`.

[meta]
tag = ur
block = 0600
stress = weight
deletion = medial
inherent = ə ʌ
anusvara = split
visarga = h
geminate = b p t ʈ ɟ c d ɖ k ɡ q
final-release = n m j r l
final-release-not-after = r n

