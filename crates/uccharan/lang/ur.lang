[pre]
# Aspirates written with do-chashmi he.
بھ -> Ḃ
پھ -> Ṕ
تھ -> Ṫ
ٹھ -> Ť
جھ -> Ĵ
چھ -> Ĉ
دھ -> Ḋ
ڈھ -> Ď
کھ -> Ḱ
گھ -> Ġ
ڑھ -> Ř
رھ -> Ŕ
لھ -> Ĺ
مھ -> Ṁ
نھ -> Ń
# Shadda doubles the consonant.
بّ -> بْب
پّ -> پْپ
تّ -> تْت
ٹّ -> ٹْٹ
ثّ -> ثْث
جّ -> جْج
چّ -> چْچ
حّ -> حْح
خّ -> خْخ
دّ -> دْد
ڈّ -> ڈْڈ
ذّ -> ذْذ
رّ -> رْر
ڑّ -> ڑْڑ
زّ -> زْز
ژّ -> ژْژ
سّ -> سْس
شّ -> شْش
صّ -> صْص
ضّ -> ضْض
طّ -> طْط
ظّ -> ظْظ
غّ -> غْغ
فّ -> فْف
قّ -> قْق
کّ -> کْک
گّ -> گْگ
لّ -> لْل
مّ -> مْم
نّ -> نْن
وّ -> وْو
یّ -> یْی
# Alif: a long vowel after a consonant, a short one at the start of a word.
ا -> Ā / {CC} _
ای -> Ӗ / # _
او -> Ŏ / # _
اً -> ȦṈ / {CC} _
نگ -> ِنْگ / {CC} _ #
ا -> Ă / # _ {CC}
ع -> Ā / {CC} _
ع -> Ă / # _
# Vav: oː after a consonant before a consonant or at the end, else v.
و -> Ō / {CC} _ {CC} | {CC} _ # | {CC} _ ں
# Ye: i at the end, eː inside a word after a consonant, y before a vowel.
ی -> ْی / {CC} _ {VL}
ی -> Ǐ / {CC} _ #
ی -> Ǐ / {CC} _ ں
ی -> Ē / # {CC} _ {CC}
ی -> Ǐ / {CC} _ {CC}
ی -> ꞁ / ئ _
ئ -> Ȧ / {CC} _
ے -> Ē / {CC} _
# Final he after a consonant is a short a.
ہ -> Ȧ / {CC} _ #
ه -> Ȧ / {CC} _ #
# Noon ghunna: nasal after alif and vav, else n.
ں -> Ñ / ا _ | و _
ں -> Ṉ

[post]
# Final unstressed ii is short.
iː -> i / {!S} _ #

[post.improved]
# ص and ظ are s and z in Urdu.
ʂ -> s
ʐ -> z

